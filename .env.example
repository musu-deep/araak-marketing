# Copy this file to .env.local for local development.
# In Vercel, add the same values under Project Settings > Environment Variables.

# These are the only values required by the marketing frontend.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# The institutional-access Edge Function uses the automatic Supabase secrets
# and the existing ARAAK CEO gateway. Odoo and service-role secrets do not need
# to be copied into the marketing Vercel project.

# Optional legacy frontend key name only when required by an older project:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
