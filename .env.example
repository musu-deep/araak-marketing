# Copy to .env.local for local development.
# Configure production values in your deployment platform.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_CLIENT_KEY

# Optional compatibility key for older clients:
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Server-side integration credentials, service-role keys, ERP credentials,
# API tokens and tenant secrets must stay in protected server/deployment secrets.
# Never commit real credentials or production identifiers to the repository.
