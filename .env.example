# Copy this file to .env.local for local development.
# In Vercel, add the same values under Project Settings > Environment Variables.

# Frontend Supabase session used as a temporary compatibility bridge for the
# existing marketing and tenders data while those models move to Odoo.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-side Supabase bridge. Never expose the service role key to Vite.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
ARAAK_IDENTITY_BRIDGE_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_24_CHARACTERS

# Existing ARAAK CEO platform identity gateway.
ARAAK_CEO_API_URL=https://musu-deep-nexgen-executives-ar.vercel.app

# Copy these Odoo values from the ARAAK CEO Vercel project.
ODOO_ENABLED=true
ODOO_URL=https://araakceo.odoo.com
ODOO_DATABASE=YOUR_ODOO_DATABASE_IF_REQUIRED
ODOO_API_KEY=YOUR_ODOO_API_KEY
ODOO_LANGUAGE=en_US
ODOO_TIMEOUT_MS=20000

# Legacy frontend key name only when required by an older Supabase project:
# VITE_SUPABASE_ANON_KEY=YOUR_LEGACY_ANON_KEY
